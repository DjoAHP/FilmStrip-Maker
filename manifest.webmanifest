{
    "name": "Filmstrip Maker",
    "short_name": "Filmstrip",
    "description": "Assemble des images en filmstrip vertical pour HISE",
    "lang": "fr",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "background_color": "#0e0f12",
